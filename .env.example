# Root .env for local backend development — apps/api's dev script sources
# this file (`../../.env` relative to apps/api). Not used by apps/web,
# which has its own .env.example (apps/web/.env.example).

NODE_ENV=development
PORT=3001

# JWT signing secret — must be at least 32 characters. Required for apps/api
# to boot at all (see apps/api/src/env.ts).
JWT_SECRET=change-me-in-production-min-32-chars

# MongoDB — apps/api's actual database. Point at a local `mongod` or your own
# Atlas/Cosmos connection string. A fresh Agent Oak deploy should use its own
# database, separate from kairos-ai's.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=agentoak

# Redis — used for caching (goals route) and rate limiting. Optional locally,
# required in production (see .github/workflows/ci.yml's services block).
# REDIS_URL=redis://localhost:6379

# At least one LLM provider is needed for goal compilation / AI extraction.
# OPENAI_API_KEY=sk-...
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01

# Google OAuth (sign-in, Gmail connector) — new OAuth client/redirect URI,
# not the same one kairos-ai's Studio uses.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# Stripe (Agent Oak Plus billing) — new Product/Price under the existing
# Stripe account, not kairos-ai's Studio pricing.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# SETTINGS_ENCRYPTION_KEY=...

# Web push (VAPID) — generate once with `npx web-push generate-vapid-keys`.
# Without these, GET /push/vapid-key returns 503 and the Settings push
# toggle silently no-ops. VAPID_SUBJECT should be a monitored mailto: or
# site URL — push services use it to reach the operator.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:...

# Marketing engine (in-house social publishing) — restricted by platform
# operator roles. Enable channels by setting their credentials; channels
# without credentials stay unlisted and publishes fail retryably.
#
# X — two paths:
#   (a) Connect flow (preferred): OAuth2 app creds; operators connect per
#       tenant from /marketing → "Connect X". Requires the X app to have
#       OAuth2 enabled (type: Web App) with callback
#       {API_BASE_URL}/connectors/twitter_x/oauth/callback and scopes
#       tweet.read tweet.write users.read offline.access.
# X_CLIENT_ID=...
# X_CLIENT_SECRET=...
#   (b) Env token: a user-context access token (OAuth1.0a portal tokens do
#       NOT work here — they need a different signing path).
# X_ACCESS_TOKEN=...
# LINKEDIN_ACCESS_TOKEN=...           (OAuth2 token, scope: w_member_social)
# LINKEDIN_AUTHOR_URN=urn:li:person:...
# BSKY_HANDLE=your.handle.bsky.social
# BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# BSKY_SERVICE_URL=https://bsky.social   (optional — PDS override)

# Initial platform operator bootstrap. Values are Agent Oak user IDs, not
# tenant IDs. Once platform_operators records exist, database-backed roles
# should be used for normal operator access.
# PLATFORM_OPERATOR_USER_IDS=<user-id>

AGENT_OAK_URL=http://localhost:3002
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: GA4 measurement ID (G-XXXXXXXXXX). Inlined into the web build;
# when unset no analytics script is emitted at all.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
