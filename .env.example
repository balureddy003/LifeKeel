# Root .env for local backend development — apps/api's dev script sources
# this file (`../../.env` relative to apps/api). Not used by apps/web,
# which has its own .env.example (apps/web/.env.example).

NODE_ENV=development
PORT=3001

# JWT signing secret — must be at least 32 characters. Required for apps/api
# to boot at all (see apps/api/src/env.ts).
JWT_SECRET=change-me-in-production-min-32-chars

# MongoDB — apps/api's actual database. Point at a local `mongod` or your own
# Atlas/Cosmos connection string. A fresh LifeKeel deploy should use its own
# database, separate from kairos-ai's.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=lifekeel

# Redis — used for rate limiting and queue inline fallback. Optional locally,
# required in production (see .github/workflows/ci.yml's services block).
# REDIS_URL=redis://localhost:6379

# At least one LLM provider is needed for AI extraction and the assistant.
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...      # GroqCloud — inference only; enable ZDR in
#                           # Console → Data Controls for zero retention
# XAI_API_KEY=xai-...       # xAI Grok — the DPA REQUIRES ZDR for personal
#                           # data: enable it in xAI Console → Team Settings
#                           # before any task routes here (check the
#                           # x-zero-data-retention response header)
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01
# Vertex AI Gemini — OAuth only (express-mode API keys do NOT work on the
# OpenAI-compatible endpoint). On Cloud Run the service's own service account
# needs roles/aiplatform.user; off-GCP set VERTEX_SERVICE_ACCOUNT_JSON.
# VERTEX_PROJECT=lifekeel-prod
# VERTEX_LOCATION=global            # or a region like europe-west1
# VERTEX_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# VERTEX_REASONING_EFFORT=low       # thinking floor; reasoning bills as output
# Operator override — forces the provider instead of first-key-wins detection.
# LIFEKEEL_LLM_PROVIDER=vertex

# Google OAuth (sign-in, Gmail connector) — new OAuth client/redirect URI,
# not the same one kairos-ai's Studio uses.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# Stripe (LifeKeel Plus billing) — new Product/Price under the existing
# Stripe account, not kairos-ai's Studio pricing.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Billing setup as code (docs/runbooks/stripe-setup.md). Optional.
# STRIPE_RECONCILE_KEY=rk_test_...      restricted key used only by the reconciler (falls back to STRIPE_SECRET_KEY)
# STRIPE_API_ORIGIN=http://localhost:3001   where Stripe reaches the webhook (the reconciler registers <origin>/billing/webhook)
# STRIPE_PRICE_STARTER=price_...        pin a price during a rollout; normally the price is found by lookup_key

# SETTINGS_ENCRYPTION_KEY=...

# Local email capture (dev only): deliver all outgoing email to the Mailpit
# inbox from compose.local.yml instead of SendGrid. Must point at localhost;
# the API refuses to boot with it set in production. Senders skip unless
# SENDGRID_API_KEY is set, so pair it with a placeholder key. See STARTER.md.
# MAILPIT_URL=http://localhost:8025
# SENDGRID_API_KEY=SG.local-mailpit-placeholder
# SENDGRID_FROM_EMAIL=accounts@lifekeel.test
# EMAIL_VERIFICATION_ENABLED=true

# Resend — cheaper email provider alternative to SendGrid (resend.com).
# Setting RESEND_API_KEY routes all outbound mail (transactional + marketing)
# through Resend's REST API instead of SendGrid; no sender code changes.
# The sender domain must be verified in Resend — set EMAIL_FROM (or the
# legacy SENDGRID_FROM_EMAIL) to an address on that domain.
# RESEND_API_KEY=re_...
# EMAIL_FROM=accounts@lifekeel.co.uk
# Optional: Svix signing secret (whsec_... from the webhook's details page).
# Enables POST /webhooks/resend — the same lifecycle_sends engagement join
# as /webhooks/sendgrid, carried on the `lk` tag instead of a custom arg.
# RESEND_WEBHOOK_SECRET=whsec_...

# Web push (VAPID) — generate once with `npx web-push generate-vapid-keys`.
# Without these, GET /push/vapid-key returns 503 and the Settings push
# toggle silently no-ops. VAPID_SUBJECT should be a monitored mailto: or
# site URL — push services use it to reach the operator.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:...

# Marketing engine (in-house social publishing) — restricted by platform
# operator roles. Enable channels by setting their credentials; channels
# without credentials stay unlisted and publishes fail retryably.
#
# X — two paths:
#   (a) Connect flow (preferred): OAuth2 app creds; operators connect per
#       tenant from /marketing → "Connect X". Requires the X app to have
#       OAuth2 enabled (type: Web App) with callback
#       {API_BASE_URL}/connectors/twitter_x/oauth/callback and scopes
#       tweet.read tweet.write users.read offline.access.
# X_CLIENT_ID=...
# X_CLIENT_SECRET=...
#   (b) Env token: a user-context access token (OAuth1.0a portal tokens do
#       NOT work here — they need a different signing path).
# X_ACCESS_TOKEN=...
#
# LinkedIn — OAuth connect (preferred): an app with "Share on LinkedIn" +
# "Sign In with LinkedIn using OpenID Connect" products, redirect
# {API_BASE_URL}/connectors/linkedin/oauth/callback. Member URN is captured
# automatically at callback. Tokens live ~60 days, then reconnect.
# LINKEDIN_CLIENT_ID=...
# LINKEDIN_CLIENT_SECRET=...
#   Env fallback (permanent token if you have one):
# LINKEDIN_ACCESS_TOKEN=...           (OAuth2 token, scope: w_member_social)
# LINKEDIN_AUTHOR_URN=urn:li:person:...
#
# Meta (Facebook Pages + Instagram Business + Threads) — one Meta app can
# hold all three. Callbacks:
#   {API_BASE_URL}/connectors/facebook_pages/oauth/callback
#   {API_BASE_URL}/connectors/instagram_business/oauth/callback
#   {API_BASE_URL}/connectors/threads/oauth/callback
# The account must manage ≥1 Facebook Page; Instagram needs a Business/
# Creator account linked to that Page. Page tokens captured at connect are
# non-expiring; Threads tokens refresh automatically for 60 days.
# META_CLIENT_ID=...
# META_CLIENT_SECRET=...
#   Threads also accepts its own pair if you run a separate Threads app:
# THREADS_CLIENT_ID=...
# THREADS_CLIENT_SECRET=...
#
# Bluesky — app password connect (per tenant, from the marketing page):
# BSKY_HANDLE=your.handle.bsky.social
# BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# BSKY_SERVICE_URL=https://bsky.social   (optional — PDS override)
#
# Mastodon — env only (no OAuth flow): an instance + token with write:statuses.
# MASTODON_INSTANCE_URL=https://mastodon.social
# MASTODON_ACCESS_TOKEN=...

# Initial platform operator bootstrap. Values are LifeKeel user IDs, not
# tenant IDs. Once platform_operators records exist, database-backed roles
# should be used for normal operator access.
# PLATFORM_OPERATOR_USER_IDS=<user-id>
# Hard expiry for the break-glass path above — an ISO timestamp after which
# env bootstrap is dead even with zero DB super_admins. Set it to
# seed-time + a short margin so break-glass cannot outlive the incident.
# PLATFORM_OPERATOR_BOOTSTRAP_UNTIL=2026-11-01T00:00:00Z
# Recent-auth window for elevated operator mutations (suspend/erase/send/
# credits/config/operators). Sessions older than this get 403 step_up_required.
# OPERATOR_STEP_UP_WINDOW_SEC=900

LIFEKEEL_URL=http://localhost:3002
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: GA4 measurement ID (G-XXXXXXXXXX). Inlined into the web build;
# when unset no analytics script is emitted at all.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: paid-ads tags — same env-gated, build-inlined convention. All
# unset = no trackers emitted. Google Ads uses the shared gtag.js; Meta and
# LinkedIn load their own tag when configured. The *_SEND_TO/CONV_* values
# are per-conversion labels from the ad platform UIs, used by lib/ad-track's
# trackConversion() on signup + quiz lead capture.
# NEXT_PUBLIC_GADS_CONVERSION_ID=AW-XXXXXXXXXX
# NEXT_PUBLIC_GADS_SEND_TO_SIGNUP=AW-XXXXXXXXXX/<label>
# NEXT_PUBLIC_GADS_SEND_TO_LEAD=AW-XXXXXXXXXX/<label>
# NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=XXXXXXX
# NEXT_PUBLIC_LINKEDIN_CONV_SIGNUP=XXXXXXXX
# NEXT_PUBLIC_LINKEDIN_CONV_LEAD=XXXXXXXX

# Optional: SendGrid event webhook verification key (base64 Ed25519 public
# key from Mail Settings → Signed Event Webhook). Enables
# POST /webhooks/sendgrid — opens/clicks/bounces join back to
# lifecycle_sends via the per-send lk custom arg, feeding campaign
# engagement stats. Unset = route returns 503.
# SENDGRID_EVENT_WEBHOOK_KEY=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE...

# Public correspondence address displayed in email footers.
EMAIL_POSTAL_ADDRESS="Milton Keynes, MK4 4NW, UK"

# ── Cloudflare integration (CLOUDFLARE_INTEGRATION.md) ──────────────────────
# Every default below is OFF in dev and ON/strict outside dev. Outside dev a
# downgrade is logged at boot; a missing secret refuses boot.
#
# /metrics scrape token (required outside dev, 24+ chars).
# METRICS_SCRAPE_TOKEN=
#
# Turnstile. off (dev default) | monitor | enforce (default outside dev).
# Cloudflare's always-pass test pair, for local/CI only:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# TURNSTILE_MODE=off
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_ALLOWED_HOSTNAMES=localhost       # defaults to LIFEKEEL_APP_HOSTS
# (web) NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#
# Email OTP. off (dev default) | signup | signup_login (default outside dev).
# In dev with no SENDGRID_API_KEY the code is logged at warn instead of sent.
# AUTH_OTP_MODE=off
# OTP_PEPPER=                                 # 32+ chars outside dev
#
# Documents in R2. gridfs (default) | r2, with a tenant allow-list (or *).
# DOCUMENTS_STORAGE=gridfs
# DOCUMENTS_R2_TENANTS=
# VAULT_STORAGE=gridfs
# R2_ACCOUNT_ID=
# R2_JURISDICTION=eu
# R2_ENDPOINT=http://localhost:9000           # MinIO locally; unset for R2
# R2_FORCE_PATH_STYLE=true                    # MinIO only
# One key pair per job, each scoped in Cloudflare to its buckets (§7.1):
# R2_PRESIGN_ACCESS_KEY_ID= / R2_PRESIGN_SECRET_ACCESS_KEY=   API: quarantine RW
# R2_SERVE_ACCESS_KEY_ID=   / R2_SERVE_SECRET_ACCESS_KEY=     API: clean read
# R2_DELETE_ACCESS_KEY_ID=  / R2_DELETE_SECRET_ACCESS_KEY=    API: clean RW (deletes)
# R2_VAULT_ACCESS_KEY_ID=   / R2_VAULT_SECRET_ACCESS_KEY=     API: vault RW
# R2_SCAN_ACCESS_KEY_ID=    / R2_SCAN_SECRET_ACCESS_KEY=      scan worker ONLY
# CLAMD_HOST=localhost                        # scan worker; required outside dev
