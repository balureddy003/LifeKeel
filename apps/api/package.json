{
  "name": "@lifekeel/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "LifeKeel backend — Fastify API for the family digital-twin data model, detector engine, and connectors",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build:workspace-deps": "pnpm --filter \"@lifekeel/api^...\" build",
    "predev": "pnpm build:workspace-deps",
    "dev": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx src/server.ts",
    "stripe:reconcile": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx src/billing/stripe-cli.ts",
    "predev:watch": "pnpm build:workspace-deps",
    "dev:watch": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx watch src/server.ts",
    "email:preview": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx src/dev/email-preview.ts",
    "predebug": "pnpm build:workspace-deps",
    "debug": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx watch --inspect=9229 src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "eval:assistant": "node dist/eval/assistant-eval.js",
    "eval:local-model": "node dist/eval/local-model-eval.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/migrate.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@lifekeel/engine": "workspace:*",
    "@lifekeel/mongodb-adapter": "workspace:*",
    "@lifekeel/pipeline": "workspace:*",
    "@lifekeel/platform": "workspace:*",
    "@lifekeel/runtime": "workspace:*",
    "@lifekeel/specifications": "workspace:*",
    "@lifekeel/workflows": "workspace:*",
    "@sendgrid/mail": "^8.1.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "5.1.0",
    "imapflow": "^1.7.6",
    "ioredis": "^5.11.1",
    "jose": "^5.9.0",
    "js-yaml": "^4.1.0",
    "lru-cache": "^11.5.3",
    "mailparser": "^3.10.0",
    "mammoth": "^1.9.0",
    "mongodb": "^7.7.0",
    "node-cron": "^4.2.1",
    "openai": "^6.41.0",
    "prom-client": "^15.1.3",
    "redis": "^6.3.0",
    "sharp": "0.35.4",
    "stripe": "^22.2.0",
    "twilio": "^6.2.0",
    "unpdf": "^1.9.1",
    "web-push": "^3.6.7",
    "yauzl": "^3.2.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@lifekeel/eslint-config": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.19.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
