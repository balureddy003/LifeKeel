{
  "name": "@kairos/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kairos reference API — Fastify + all three packages wired together",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx src/server.ts",
    "dev:watch": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/migrate.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@kairos/engine": "workspace:*",
    "@kairos/legacy-compat": "workspace:*",
    "@kairos/mongodb-adapter": "workspace:*",
    "@kairos/pipeline": "workspace:*",
    "@kairos/platform": "workspace:*",
    "@kairos/runtime": "workspace:*",
    "@kairos/specifications": "workspace:*",
    "@kairos/workflows": "workspace:*",
    "@sendgrid/mail": "^8.1.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "5.1.0",
    "imapflow": "^1.7.6",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.1.0",
    "lru-cache": "^11.5.2",
    "mailparser": "^3.9.16",
    "mongodb": "^7.3.0",
    "node-cron": "^4.2.1",
    "openai": "^6.41.0",
    "prom-client": "^15.1.3",
    "redis": "^6.0.0",
    "stripe": "^22.2.0",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
