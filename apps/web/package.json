{
  "name": "@lifekeel/web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "LifeKeel web app — the autonomous digital twin for your family",
  "scripts": {
    "dev": "next dev --port 3002",
    "debug": "NODE_OPTIONS=--inspect=9230 next dev --port 3002",
    "prebuild": "node scripts/make-security-txt.mjs",
    "build": "next build",
    "prebuild:export": "node scripts/make-security-txt.mjs",
    "build:export": "FIREBASE_STATIC_EXPORT=1 next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.86",
    "@sentry/browser": "^8.0.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^12.2.0",
    "next": "^15.5.28",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
