# Base URL of the backend API LifeKeel talks to.
# Currently points at the shared kairos-ai apps/api (Cloud Run) — this app
# has no other dependency on that repo. Will move to a dedicated LifeKeel
# backend in a follow-up.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sentry DSN for client-side error/perf reporting (src/lib/observability.ts).
# Optional — everything is a no-op until this is set. Session Replay is
# deliberately not enabled anywhere in this app (see SECURITY.md).
# NEXT_PUBLIC_SENTRY_DSN=

# Support inbox shown on /support (src/app/support/page.tsx). Until set to a
# real, monitored address the page renders an explicit "not live yet" state
# instead of a fake contact path.
# NEXT_PUBLIC_SUPPORT_EMAIL=
