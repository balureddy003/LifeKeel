{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "no_proxy",
    "NODE_EXTRA_CA_CERTS", "SSL_CERT_FILE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/**"],
      "cache": false,
      "passThroughEnv": ["MONGODB_URL", "REDIS_URL", "MONGODB_DB", "JWT_SECRET"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["build", "^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
