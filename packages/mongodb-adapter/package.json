{
  "name": "@agentoak/mongodb-adapter",
  "version": "0.1.0",
  "description": "MongoDB adapters for the outcome-lifecycle runtime ports",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentoak/runtime": "workspace:*",
    "@agentoak/specifications": "workspace:*",
    "mongodb": "^7.3.0"
  },
  "devDependencies": {
    "@agentoak/conformance": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "license": "Apache-2.0"
}
