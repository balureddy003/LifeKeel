{
  "name": "@lifekeel/pipeline",
  "version": "0.1.0",
  "description": "Connector data pipeline — normalizes any connector's data into events, deduplicates via SHA-256",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lifekeel/engine": "workspace:*",
    "@lifekeel/platform": "workspace:^",
    "js-yaml": "^4.1.0",
    "papaparse": "^5.5.3",
    "zod": "^3.23.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@lifekeel/eslint-config": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "eslint": "^9.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "license": "BUSL-1.1"
}
