{
  "name": "@lifekeel/engine",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Deterministic rules engine — YAML detectors + LLM scoring + evidence chains — powers LifeKeel's Family Intelligence layer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lifekeel/platform": "workspace:^",
    "chokidar": "^5.0.0",
    "filtrex": "^3.1.0",
    "js-yaml": "^4.1.0",
    "lru-cache": "^11.5.3",
    "mongodb": "^7.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@lifekeel/eslint-config": "workspace:*",
    "@types/chokidar": "^2.1.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "eslint": "^9.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "lifekeel",
    "rules-engine",
    "deterministic-ai",
    "llm",
    "yaml"
  ]
}
