{
  "name": "@lifekeel/runtime",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Replaceable runtime ports and reference adapters for the outcome-lifecycle model",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lifekeel/specifications": "workspace:*"
  },
  "devDependencies": {
    "@lifekeel/eslint-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
