{
  "name": "@lifekeel/platform",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Shared platform primitives — JWT auth, MongoDB, OTel, Decimal money, multi-tenant middleware",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "@lifekeel/runtime": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "jose": "^5.9.0",
    "lru-cache": "^11.5.3",
    "mongodb": "^7.7.0",
    "openai": "^6.41.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@lifekeel/eslint-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
