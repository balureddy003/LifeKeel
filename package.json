{
  "name": "agent-oak",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Oak — the autonomous digital twin for your family. Monorepo: apps/web (Next.js frontend), apps/api (Fastify backend), packages/* (shared engine/platform packages).",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "debug": "pnpm --parallel --filter @agentoak/api --filter @agentoak/web run debug",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "turbo": "^2.3.0"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": "pnpm --filter @agentoak/web exec eslint --fix"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.5"
}
