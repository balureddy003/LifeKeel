{
  "name": "lifekeel",
  "version": "0.1.0",
  "private": true,
  "description": "LifeKeel — the autonomous digital twin for your family. Monorepo: apps/web (Next.js frontend), apps/api (Fastify backend), packages/* (shared engine/platform packages).",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "debug": "pnpm --parallel --filter @lifekeel/api --filter @lifekeel/web run debug",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.19.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "turbo": "^2.11.8"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": "pnpm --filter @lifekeel/web exec eslint --fix",
    "apps/api/**/*.ts": "eslint --config packages/eslint-config/src/node.js --fix",
    "packages/**/*.ts": "eslint --config packages/eslint-config/src/node.js --fix",
    "*.{ts,tsx,js,mjs,cjs,json,yaml,yml,md}": "prettier --write"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.5",
  "pnpm": {
    "overrides": {
      "lodash-es@<4.18.0": "4.18.1",
      "postcss@<8.5.18": "8.5.30",
      "brace-expansion@<1.1.20": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.11": "5.0.12",
      "source-map-js@<1.2.2": "1.2.2",
      "sharp@<0.35.5": "0.35.5"
    }
  }
}
