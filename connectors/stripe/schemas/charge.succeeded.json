{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifekeel.io/schemas/stripe/charge.succeeded/v1.0.0",
  "title": "Stripe Charge Succeeded Event",
  "description": "Schema for Stripe charge.succeeded webhook events",
  "type": "object",
  "lifekeel": {
    "connector_id": "stripe",
    "event_type": "charge.succeeded",
    "schema_version": "1.0.0",
    "signal_type": "payment.received",
    "min_schema_version": "1.0.0"
  },
  "required": [
    "id",
    "object",
    "created",
    "amount",
    "currency",
    "customer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Charge identifier (ch_...)"
    },
    "object": {
      "type": "string",
      "const": "charge"
    },
    "created": {
      "type": "integer",
      "description": "Unix timestamp of charge creation"
    },
    "amount": {
      "type": "integer",
      "description": "Amount in minor units (cents)"
    },
    "currency": {
      "type": "string",
      "pattern": "^[a-z]{3}$",
      "description": "ISO 4217 currency code"
    },
    "customer": {
      "type": "string",
      "description": "Customer ID (cus_...)"
    },
    "status": {
      "type": "string",
      "const": "succeeded"
    },
    "paid": {
      "type": "boolean",
      "const": true
    },
    "metadata": {
      "type": "object",
      "description": "Key-value metadata attached to the charge"
    }
  }
}
