{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifekeel.io/schemas/shopify/orders.create/v1.0.0",
  "title": "Shopify Order Created Event",
  "description": "Schema for Shopify orders/create webhook events",
  "type": "object",
  "lifekeel": {
    "connector_id": "shopify",
    "event_type": "orders/create",
    "schema_version": "1.0.0",
    "signal_type": "order.placed",
    "min_schema_version": "1.0.0"
  },
  "required": [
    "id",
    "created_at",
    "total_price",
    "currency",
    "customer"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Order ID"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of order creation"
    },
    "total_price": {
      "type": "string",
      "description": "Order total as decimal string (e.g., '100.00')"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code"
    },
    "customer": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Customer ID"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "line_items": {
      "type": "array",
      "description": "Order line items",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "product_id": {
            "type": "integer"
          },
          "quantity": {
            "type": "integer"
          },
          "price": {
            "type": "string"
          }
        }
      }
    },
    "financial_status": {
      "type": "string",
      "enum": ["pending", "authorized", "paid", "partially_paid", "voided", "refunded"],
      "description": "Order financial status"
    }
  }
}
