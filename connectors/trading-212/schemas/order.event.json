{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifekeel.io/schemas/trading-212/order.event/v1.0.0",
  "title": "Trading 212 Order Event",
  "description": "Executed order or transaction event (buy, sell, dividend).",
  "type": "object",
  "lifekeel": {
    "connector_id": "trading-212",
    "event_type": "order.event",
    "schema_version": "1.0.0",
    "signal_type": "order_event",
    "min_schema_version": "1.0.0"
  },
  "required": [
    "type",
    "ticker",
    "quantity",
    "price",
    "timestamp",
    "currency"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["buy", "sell", "dividend"],
      "description": "Order type."
    },
    "ticker": {
      "type": "string",
      "description": "Instrument ticker symbol."
    },
    "quantity": {
      "type": "number",
      "description": "Number of units."
    },
    "price": {
      "type": "integer",
      "description": "Execution price in minor units of the currency."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the order was executed."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code of the transaction."
    }
  }
}
