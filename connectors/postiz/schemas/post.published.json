{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.io/schemas/postiz/post.published/v1.0.0",
  "title": "Postiz Post Published Event",
  "description": "Schema for Postiz post.published webhook events",
  "type": "object",
  "kairos": {
    "connector_id": "postiz",
    "event_type": "post.published",
    "schema_version": "1.0.0",
    "signal_type": "post.published",
    "min_schema_version": "1.0.0"
  },
  "required": [
    "id",
    "content",
    "platforms",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Post identifier"
    },
    "content": {
      "type": "string",
      "description": "Post content text"
    },
    "platforms": {
      "type": "array",
      "description": "Target platforms for the post",
      "items": {
        "type": "string",
        "enum": ["twitter", "linkedin", "facebook", "instagram", "tiktok", "youtube", "pinterest", "reddit", "telegram"]
      }
    },
    "media_urls": {
      "type": "array",
      "description": "Media URLs attached to the post",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of post creation"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp for scheduled posts"
    },
    "status": {
      "type": "string",
      "enum": ["published", "scheduled", "failed", "deleted"],
      "description": "Post status"
    },
    "engagement": {
      "type": "object",
      "description": "Engagement metrics",
      "properties": {
        "likes": {
          "type": "integer"
        },
        "shares": {
          "type": "integer"
        },
        "comments": {
          "type": "integer"
        }
      }
    }
  }
}
