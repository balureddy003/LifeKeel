{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.io/schemas/zerodha/order.event/v1.0.0",
  "title": "Zerodha Order Event",
  "description": "An order or trade event synced from Zerodha via Kite Connect v3. Kite exposes per-day order and trade lists; real-time fills arrive via postback webhooks.",
  "type": "object",
  "kairos": {
    "connector_id": "zerodha",
    "event_type": "order.event",
    "schema_version": "1.0.0",
    "signal_type": "order_event",
    "min_schema_version": "1.0.0"
  },
  "required": [
    "order_id",
    "ticker",
    "type",
    "status",
    "timestamp",
    "currency"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Kite order identifier."
    },
    "trade_id": {
      "type": "string",
      "description": "Kite trade identifier (trade records only)."
    },
    "ticker": {
      "type": "string",
      "description": "Exchange tradingsymbol (e.g. SBIN, INFY)."
    },
    "exchange": {
      "type": "string",
      "enum": ["NSE", "BSE", "NFO", "BFO", "MCX", "CDS", "BCD"],
      "description": "Exchange the instrument is listed on."
    },
    "type": {
      "type": "string",
      "enum": ["buy", "sell"],
      "description": "Transaction type (transaction_type mapped to lowercase)."
    },
    "status": {
      "type": "string",
      "enum": ["complete", "rejected", "cancelled", "pending", "open", "traded", "after market order req received"],
      "description": "Order status (lowercased)."
    },
    "variety": {
      "type": "string",
      "enum": ["regular", "amo", "co", "iceberg", "auction"],
      "description": "Order variety."
    },
    "order_type": {
      "type": "string",
      "enum": ["market", "limit", "sl", "sl-m"],
      "description": "Order type (lowercased)."
    },
    "product": {
      "type": "string",
      "enum": ["cnc", "mis", "nrml", "bo", "co"],
      "description": "Kite product type (lowercased)."
    },
    "quantity": {
      "type": "number",
      "description": "Ordered quantity."
    },
    "filled_quantity": {
      "type": "number",
      "description": "Quantity filled so far."
    },
    "pending_quantity": {
      "type": "number",
      "description": "Quantity still pending."
    },
    "fill_price": {
      "type": "integer",
      "description": "Average fill price in paise (minor units of INR)."
    },
    "limit_price": {
      "type": "integer",
      "description": "Limit price in paise (minor units of INR), for limit/SL orders."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of the order/trade/exchange event."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code. Zerodha accounts are INR-denominated."
    }
  }
}
