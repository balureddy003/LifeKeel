{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos.io/schemas/alpha-vantage/market.price/v1.0.0",
  "title": "Alpha Vantage Market Price",
  "description": "Daily market price for a single ticker from a market-data provider.",
  "type": "object",
  "kairos": {
    "connector_id": "alpha-vantage",
    "event_type": "market.price",
    "schema_version": "1.0.0",
    "signal_type": "market_price",
    "min_schema_version": "1.0.0"
  },
  "required": [
    "ticker",
    "date",
    "price"
  ],
  "properties": {
    "ticker": {
      "type": "string",
      "description": "Instrument ticker symbol."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Trading date in YYYY-MM-DD format."
    },
    "price": {
      "type": "number",
      "description": "Closing price in major currency units."
    },
    "volume": {
      "type": "number",
      "description": "Trading volume for the day."
    }
  }
}
