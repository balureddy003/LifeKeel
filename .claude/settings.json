{
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__tabs_context_mcp",
      "ClaudeInChromeDomain(localhost:3002)",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "ClaudeInChromeDomain(localhost:8025)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(gh repo delete*)",
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/.next/**)",
      "Read(./**/.turbo/**)",
      "Read(./pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/advice-check.sh"
          }
        ]
      }
    ]
  }
}
